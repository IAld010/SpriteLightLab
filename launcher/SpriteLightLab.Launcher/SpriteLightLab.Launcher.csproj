<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SpriteLightLab</AssemblyName>
    <AssemblyTitle>Sprite Light Lab local launcher</AssemblyTitle>
    <RootNamespace>SpriteLightLab.Launcher</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.5.0</Version>
    <FileVersion>1.0.5.0</FileVersion>
    <AssemblyVersion>1.0.5.0</AssemblyVersion>
    <InformationalVersion>1.0.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Sprite Light Lab</Product>
    <Description>Sprite Light Lab local launcher</Description>
    <Copyright>Copyright (c) 2026 Sprite Light Lab contributors</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\wwwroot.zip" LogicalName="SpriteLightLab.wwwroot.zip" />
  </ItemGroup>

</Project>